---
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHero from '../components/PageHero.astro';
import QuoteCTA from '../components/QuoteCTA.astro';
---

<BaseLayout
  title="Other Services | Optima Transport"
  description="Secondary services from Optima Transport including house removals, commercial clearances, commercial removals and transport support."
  canonicalPath="/other-services"
>
  <PageHero
    eyebrow="Other Services"
    title="Additional Services Alongside House Clearances"
    intro="House clearances are our primary focus. Optima also provides selected removals and transport services where they add practical value for homeowners and property professionals."
    primaryCtaLabel="Get a Free Quote"
  />

  <section class="section">
    <div class="container grid-3">
      <article class="card">
        <h2>House Removals</h2>
        <p>Full house moves, local or nationwide, with careful handling and planned delivery.</p>
        <p><a href="/house-removals" class="btn btn-secondary">House Removals</a></p>
      </article>
      <article class="card">
        <h2>Commercial Clearances</h2>
        <p>Clearance support for commercial units and workplaces where contents must be removed.</p>
        <p><a href="/commercial-removals" class="btn btn-secondary">Commercial Services</a></p>
      </article>
      <article class="card">
        <h2>Furniture And Specialist Transport</h2>
        <p>Transport support for selected furniture and bulky items linked to moves or clearances.</p>
        <p><a href="/transport-services" class="btn btn-secondary">Transport Services</a></p>
      </article>
    </div>
  </section>

  <QuoteCTA title="Need A Quote For A Secondary Service?" text="Tell us about the job and we will confirm the most suitable service and next steps." />
</BaseLayout>
