---
interface Step {
  title: string;
  detail: string;
}

interface Props {
  steps: Step[];
}

const { steps } = Astro.props;
---

<ol class="process-grid">
  {steps.map((step, i) => (
    <li class="card">
      <span class="step-count">{String(i + 1).padStart(2, '0')}</span>
      <h3>{step.title}</h3>
      <p>{step.detail}</p>
    </li>
  ))}
</ol>

<style>
  .process-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(210px, 1fr));
    gap: 1rem;
  }

  .step-count {
    display: inline-block;
    font-family: var(--font-heading);
    color: var(--colour-accent);
    font-size: 1.25rem;
    margin-bottom: 0.7rem;
    font-weight: 800;
  }

  @media (max-width: 620px) {
    .process-grid {
      grid-template-columns: 1fr;
    }
  }
</style>
