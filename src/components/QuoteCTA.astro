---
interface Props {
  title?: string;
  text?: string;
}

const {
  title = 'Need A Property Cleared?',
  text = 'Get a free, no-obligation quote for your clearance. Tell us what needs to stay and what needs to go, and we will plan the rest.'
} = Astro.props;
---

<section class="section">
  <div class="container">
    <div class="cta panel">
      <div>
        <p class="eyebrow">Get Started</p>
        <h2>{title}</h2>
        <p>{text}</p>
      </div>
      <div class="cta-actions">
        <a class="btn btn-primary" href="/quote">Get a Free Clearance Quote</a>
        <a class="btn btn-secondary" href="tel:+441134001234">Call Optima</a>
      </div>
    </div>
  </div>
</section>

<style>
  .cta {
    display: grid;
    gap: 1rem;
    grid-template-columns: 1.2fr auto;
    align-items: center;
  }

  .cta-actions {
    display: grid;
    gap: 0.7rem;
  }

  @media (max-width: 800px) {
    .cta {
      grid-template-columns: 1fr;
    }

    .cta-actions {
      grid-template-columns: 1fr;
    }
  }
</style>
