---
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHero from '../components/PageHero.astro';
import QuoteCTA from '../components/QuoteCTA.astro';
---

<BaseLayout
  title="Landlord Property Clearances | Optima Transport"
  description="Property clearances for landlords, letting agents, property managers and investors across Yorkshire, including end-of-tenancy and refurbishment-ready clearances."
  canonicalPath="/landlord-property-clearances"
>
  <PageHero
    eyebrow="Landlord Property Clearances"
    title="Clear Properties Faster For Reletting, Sale Or Refurbishment"
    intro="Optima supports landlords, letting agents, property managers and investors with professional property clearances, from abandoned contents through to full end-of-tenancy clearances."
    primaryCtaLabel="Get a Landlord Clearance Quote"
    imageAriaLabel="Placeholder for real Optima landlord property clearance photography"
    imageAlt="Placeholder: cleared rental property room ready for next stage"
  />

  <section class="section">
    <div class="container grid-2">
      <article class="panel">
        <h2>End-Of-Tenancy Clearances</h2>
        <p>
          Remove abandoned furniture and belongings so properties can move quickly to repairs, cleaning and reletting.
        </p>
      </article>
      <article class="panel">
        <h2>Investor And Refurb Projects</h2>
        <p>
          Full property clearances for newly acquired homes and flats that need emptying before works begin.
        </p>
      </article>
    </div>
  </section>

  <section class="section-tight">
    <div class="container grid-3">
      <article class="card"><h3>Full Property Clearance</h3><p>Clear complete units where all unwanted contents must be removed.</p></article>
      <article class="card"><h3>Partial Clearance</h3><p>Target selected rooms or retained tenancy items where only part of the property is affected.</p></article>
      <article class="card"><h3>Bulky Item Removal</h3><p>Remove larger items and awkward furniture with practical access planning.</p></article>
    </div>
  </section>

  <section class="section">
    <div class="container panel">
      <h2>Built For Ongoing Property Work</h2>
      <p>
        We provide clear communication and reliable attendance to support repeat instructions from landlords,
        management teams and agents.
      </p>
      <p><a class="btn btn-primary" href="/quote">Request A Property Clearance Quote</a></p>
    </div>
  </section>

  <section class="section-tight">
    <div class="container panel">
      <h2>Reviews Placeholder</h2>
      <p>Add verified landlord, letting agent and property professional feedback here.</p>
    </div>
  </section>

  <QuoteCTA
    title="Need A Rental Or Investment Property Cleared?"
    text="Send property details and timescales and we will provide a clear quotation for the required scope."
  />
</BaseLayout>
