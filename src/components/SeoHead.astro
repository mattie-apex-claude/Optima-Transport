---
import { site } from '../data/site.js';
import Analytics from './Analytics.astro';

interface Props {
  title: string;
  description: string;
  path: string;
  image?: { src: string; width?: number; height?: number; alt?: string };
  schema?: object[];
  noindex?: boolean;
}

const { title, description, path, image = { src: site.defaultImage, width: 1200, height: 630 }, schema = [], noindex = false } = Astro.props;

const canonical = new URL(path, site.url).href;
const imageUrl = new URL(image.src, site.url).href;
const jsonLd = (data: object) => JSON.stringify(data).replace(/</g, '\\u003c');
---

<meta charset="UTF-8" />
<meta name="viewport" content="width=device-width, initial-scale=1" />
<link rel="icon" href="/favicon.ico" sizes="48x48" />
<link rel="icon" type="image/png" sizes="32x32" href="/favicon-32x32.png" />
<link rel="icon" type="image/png" sizes="16x16" href="/favicon-16x16.png" />
<link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />
<link rel="manifest" href="/site.webmanifest" />
<meta name="theme-color" content="#18181a" />
<link rel="preload" href="/fonts/sora-latin-variable.woff2" as="font" type="font/woff2" crossorigin />
<link rel="preload" href="/fonts/source-sans-3-latin-variable.woff2" as="font" type="font/woff2" crossorigin />
<title>{title}</title>
<meta name="description" content={description} />
<link rel="canonical" href={canonical} />
{noindex ? <meta name="robots" content="noindex, follow" /> : <meta name="robots" content="index, follow, max-image-preview:large" />}
<meta property="og:type" content="website" />
<meta property="og:locale" content="en_GB" />
<meta property="og:site_name" content={site.name} />
<meta property="og:title" content={title} />
<meta property="og:description" content={description} />
<meta property="og:url" content={canonical} />
<meta property="og:image" content={imageUrl} />
{image.width && <meta property="og:image:width" content={String(image.width)} />}
{image.height && <meta property="og:image:height" content={String(image.height)} />}
{image.alt && <meta property="og:image:alt" content={image.alt} />}
<meta name="twitter:card" content="summary_large_image" />
<meta name="twitter:title" content={title} />
<meta name="twitter:description" content={description} />
<meta name="twitter:image" content={imageUrl} />
{schema.map((item) => <script type="application/ld+json" set:html={jsonLd(item)} />)}
<Analytics />
