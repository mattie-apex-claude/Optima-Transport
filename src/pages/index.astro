<script>
  const rows = document.querySelectorAll('.service-index a[data-preview]');
  const preview = document.getElementById('service-preview-image');

  if (preview && rows.length) {
    for (const row of rows) {
      row.addEventListener('mouseenter', () => {
        const image = row.getAttribute('data-preview');
        const alt = row.getAttribute('data-alt');
        if (!image) return;
        preview.setAttribute('src', image);
        preview.setAttribute('alt', alt ?? 'Service image placeholder');
        rows.forEach((item) => item.classList.remove('active'));
        row.classList.add('active');
      });
    }
  }
</script>
