---
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHero from '../components/PageHero.astro';
import QuoteCTA from '../components/QuoteCTA.astro';
---

<BaseLayout
  title="Transport Services | Optima Transport"
  description="Independent Yorkshire transport services for residential and commercial requirements, with local and nationwide capability."
  canonicalPath="/transport-services"
>
  <PageHero
    eyebrow="Transport Services"
    title="Reliable Transport Support From A Local Independent Team"
    intro="Alongside property clearances and house removals, Optima provides dependable transport services for residential and commercial clients across Yorkshire and beyond."
  />

  <section class="section">
    <div class="container grid-3">
      <article class="card">
        <h2>Residential Transport</h2>
        <p>Support for planned household transport jobs where careful handling and punctuality matter.</p>
      </article>
      <article class="card">
        <h2>Commercial Transport</h2>
        <p>Delivery and movement support for businesses requiring reliable local or longer-distance transport.</p>
      </article>
      <article class="card">
        <h2>Flexible Coverage</h2>
        <p>Yorkshire-based operations with nationwide capability for suitable transport requests.</p>
      </article>
    </div>
  </section>

  <QuoteCTA title="Need A Transport Quote?" text="Tell us what needs moving, where from and where to, and we will come back with a clear response." />
</BaseLayout>
