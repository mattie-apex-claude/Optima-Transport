---
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHero from '../components/PageHero.astro';
import QuoteCTA from '../components/QuoteCTA.astro';
---

<BaseLayout
  title="Probate House Clearances in Yorkshire | Optima Transport"
  description="Respectful probate and bereavement house clearances across Yorkshire. Families decide what stays, Optima handles the agreed practical clearance work."
  canonicalPath="/probate-house-clearances"
>
  <PageHero
    eyebrow="Probate House Clearances"
    title="Respectful Property Clearance Support During Bereavement"
    intro="When families are managing a loved one's home, the practical workload can feel overwhelming. Optima provides calm, professional clearance support while the family stays in control of what is retained."
    primaryCtaLabel="Get a Probate Clearance Quote"
    imageAriaLabel="Placeholder for real Optima probate house clearance photography"
    imageAlt="Placeholder: respectful property clearance preparation scene"
  />

  <section class="section">
    <div class="container panel">
      <h2>The Family Decides What Stays</h2>
      <p>
        You identify the belongings that must remain, be sent to family members, or be removed as part of the agreed
        clearance. We focus on practical delivery and clear communication.
      </p>
    </div>
  </section>

  <section class="section-tight">
    <div class="container grid-2">
      <article class="card">
        <h2>Common Situations We Help With</h2>
        <ul class="bullets">
          <li>Executor managing an estate property</li>
          <li>Family member arranging a clearance on behalf of relatives</li>
          <li>Property preparation for sale or listing</li>
          <li>Families living outside Yorkshire needing practical local support</li>
          <li>Belongings needing delivery to multiple family addresses</li>
        </ul>
      </article>
      <article class="card">
        <h2>What The Service Can Include</h2>
        <ul class="bullets">
          <li>Pre-clearance assessment and quotation</li>
          <li>Careful separation of retained items</li>
          <li>Full or partial property clearance</li>
          <li>Responsible routing of unwanted contents</li>
          <li>Final sweep-through of agreed areas</li>
        </ul>
      </article>
    </div>
  </section>

  <section class="section">
    <div class="container panel">
      <h2>A Calm, Practical Process</h2>
      <p>
        We agree a clear scope, confirm what should remain, then complete the clearance work professionally.
        Communications remain straightforward so families can make informed decisions without unnecessary pressure.
      </p>
      <p class="helper">
        Optima does not provide legal probate advice. This page covers practical clearance support only.
      </p>
    </div>
  </section>

  <section class="section-tight">
    <div class="container panel">
      <h2>Reviews Placeholder</h2>
      <p>Add verified probate and bereavement clearance feedback here when available.</p>
    </div>
  </section>

  <QuoteCTA
    title="Need Support Clearing A Loved One's Property?"
    text="Tell us what needs to remain and what needs to be cleared. We will provide a clear quote and practical next steps."
  />
</BaseLayout>

<style>
  .bullets {
    list-style: disc;
    margin-left: 1.2rem;
    display: grid;
    gap: 0.45rem;
  }
</style>
